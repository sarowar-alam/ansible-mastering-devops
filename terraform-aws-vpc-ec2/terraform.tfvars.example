# Copy this file to terraform.tfvars and adjust values as needed.
# terraform.tfvars is git-ignored and must never contain secrets - none of
# these values are secrets, but keep this file yours locally regardless.

aws_region  = "ap-south-1"
aws_profile = "sarowar-ostad"

environment  = "dev"
project_name = "terraform-aws-infrastructure"

vpc_cidr = "10.0.0.0/16"

public_subnet_cidr   = "10.0.1.0/24"
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

instance_type         = "t3.micro"
instance_architecture = "x86_64"

root_volume_size = 20
root_volume_type = "gp3"

# Must already exist - Terraform will NOT create/modify IAM.
ssm_instance_profile_name = "SSM"

# Leave empty to disable SSH entirely and rely on SSM Session Manager.
allowed_ssh_cidr = ""

additional_ingress_ports = []

common_tags = {
  Project     = "terraform-aws-infrastructure"
  Environment = "dev"
  ManagedBy   = "terraform"
}
