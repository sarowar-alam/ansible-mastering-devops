# Local .terraform directories
**/.terraform/*

# Terraform lock file (keep if you want reproducible providers; ignore if not)
# .terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files that may contain sensitive data
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Plan output files
*.tfplan
*.tfplan.*
plan.out

# OS / editor files
.DS_Store
Thumbs.db
